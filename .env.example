# Non-secret model configuration
MODEL_NAME=step-3.7-flash
MODEL_BASE_URL=https://api.stepfun.com/step_plan/v1
STEP_IMAGE_MODEL=step-image-edit-2

# Replace every credential placeholder with your own value.
MODEL_API_KEY=replace-with-your-model-api-key

# DeepSeek V4 Pro uses the OpenAI-compatible API. The key is optional at
# startup; without it the model is listed as unavailable.
DEEPSEEK_MODEL_NAME=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# Conversation-scoped context compression. Token counts use LangChain's
# provider-neutral approximation; these limits remain model-specific.
STEP_CONTEXT_WINDOW_TOKENS=256000
STEP_SUMMARY_TRIGGER_TOKENS=64000
STEP_SUMMARY_KEEP_RECENT_TOKENS=16000
DEEPSEEK_CONTEXT_WINDOW_TOKENS=1000000
DEEPSEEK_SUMMARY_TRIGGER_TOKENS=128000
DEEPSEEK_SUMMARY_KEEP_RECENT_TOKENS=24000
SUMMARY_MAX_CHARACTERS=12000

# Recipe-pipeline embeddings only. Keep these out of frontend/Java configuration.
RECIPE_EMBEDDING_PROVIDER=sentence-transformers
RECIPE_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RECIPE_EMBEDDING_BASE_URL=
RECIPE_EMBEDDING_API_KEY=
RECIPE_EMBEDDING_BATCH_SIZE=16
RECIPE_EMBEDDING_DIMENSION=384
RECIPE_EMBEDDING_DEVICE=cpu
RECIPE_EMBEDDING_TIMEOUT_SECONDS=30

# Dedicated PostgreSQL + pgvector Recipe Knowledge Base (not application MySQL).
RECIPE_DB_HOST=127.0.0.1
RECIPE_DB_PORT=55432
RECIPE_DB_NAME=recipe_kb
RECIPE_DB_USER=recipe_kb
RECIPE_DB_PASSWORD=replace-with-a-dedicated-recipe-db-password
RECIPE_DB_CONNECT_TIMEOUT_SECONDS=5
RECIPE_DB_POOL_MIN_SIZE=1
RECIPE_DB_POOL_MAX_SIZE=4

# The Agent may query this explicitly pinned VALIDATED dataset. It never selects
# the newest dataset automatically and this does not mark recipes human-reviewed.
RECIPE_DATASET_VERSION=golden_500_v1
RECIPE_COVERAGE_POLICY_VERSION=recipe-coverage-v1
RECIPE_COVERAGE_MIN_SEMANTIC_SCORE=0.80
RECIPE_COVERAGE_MIN_INGREDIENT_RATIO=0.50
RECIPE_COVERAGE_MAX_MISSING_REQUIRED=3

# Deterministic safety boundary for forum-draft conversation history.
FORUM_DRAFT_MAX_HISTORY_CHARACTERS=24000
FORUM_DRAFT_RECENT_MESSAGES=12
TAVILY_API_KEY=replace-with-your-tavily-api-key

# MySQL must already contain this database. Use a dedicated, limited user.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=replace-with-your-mysql-user
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DATABASE=agent_web

# Public HTTPS image used only by app/main.py's demonstration.
DEMO_IMAGE_URL=https://example.com/path/to/ingredients.jpg
