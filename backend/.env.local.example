# Java business database. Create the database before starting Spring Boot.
DB_URL=jdbc:mysql://127.0.0.1:3306/ai_cooker_business?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USERNAME=replace-with-your-business-database-user
DB_PASSWORD=replace-with-your-business-database-password

# Use a unique random value containing at least 32 UTF-8 bytes.
JWT_SECRET=replace-with-a-random-local-jwt-secret-at-least-32-bytes

# Alibaba Cloud OSS. Keep the bucket private.
ALIYUN_OSS_ENDPOINT=https://oss-your-region.aliyuncs.com
ALIYUN_OSS_REGION=replace-with-your-oss-region
ALIYUN_OSS_BUCKET_NAME=replace-with-your-private-bucket-name
ALIYUN_OSS_ACCESS_KEY_ID=replace-with-your-oss-access-key-id
ALIYUN_OSS_ACCESS_KEY_SECRET=replace-with-your-oss-access-key-secret

# Local service connectivity.
AI_COOKER_BASE_URL=http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional local overrides.
AI_COOKER_CONNECT_TIMEOUT=2s
AI_COOKER_READ_TIMEOUT=120s
ALIYUN_OSS_SIGNED_URL_TTL=15m
IMAGE_MAX_FILE_SIZE=10MB
IMAGE_MAX_REQUEST_SIZE=11MB
